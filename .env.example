# CHRONO-LEAK environment variables
# Copy this file to ".env" and fill in your keys. Nothing here is required
# to get started — each key just unlocks an extra capability.

# Grok (xAI) — powers the AI Analyst layer.
# Without it, CHRONO-LEAK falls back to an offline template brief.
# Get a key at https://console.x.ai
GROK_API_KEY=your_key_here

# Optional: GitHub token raises the API limit from 60 -> 5000 requests/hour.
# No scopes needed. Get one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: HaveIBeenPwned key — enables the email breach check in the
# standalone breach_checker module. The password check works without it.
# Get a key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
