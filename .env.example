# CHRONO-LEAK environment variables
# Copy this file to ".env" and fill in your keys.

# Grok (xAI) — powers the AI Analyst layer.
# Get a key at https://console.x.ai
GROK_API_KEY=your_key_here

# Optional: GitHub token raises API limit from 60 -> 5000 requests/hour.
# Get one (no scopes needed) at https://github.com/settings/tokens
GITHUB_TOKEN=
